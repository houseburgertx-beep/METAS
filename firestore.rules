rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{userId} {
      allow read, write: if signedIn();
    }
    match /units/{unitId} {
      allow read, write: if signedIn();
    }
    match /goals/{goalId} {
      allow read, write: if signedIn();
    }
    match /dailySales/{saleId} {
      allow read, write: if signedIn();
    }
    match /cmvEntries/{entryId} {
      allow read, write: if signedIn();
    }
    match /monthlyPerformance/{id} {
      allow read, write: if signedIn();
    }
    match /aiAnalyses/{id} {
      allow read, write: if signedIn();
    }
    match /settings/{id} {
      allow read, write: if signedIn();
    }
  }
}
